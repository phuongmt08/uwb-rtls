  <property name="styleSheet">
   <string notr="true">QWidget#GeofenceEditorWidget { background: transparent; color: #E5E7EB; font-family: 'Segoe UI'; font-size: 12px; }
QFrame#editor_header, QFrame#status_strip, QFrame#tool_palette, QFrame#inspector_frame, QFrame#io_frame { background: rgba(10, 16, 28, 0.82); border: 1px solid rgba(71, 85, 105, 0.82); border-radius: 8px; }
QLabel { background: transparent; color: #CBD5E1; }
QLabel#lbl_geofence_header { color: #F8FAFC; font-size: 15px; font-weight: bold; }
QLabel#lbl_editor_subtitle, QLabel#lbl_tool_hint, QLabel#lbl_room_hint, QLabel#lbl_rule_hint { color: #94A3B8; font-size: 11px; }
QLabel#lbl_section_title { color: #E0F2FE; font-size: 12px; font-weight: bold; letter-spacing: 0px; }
QLabel#lbl_minor_resolution { color: #22D3EE; font-family: 'Consolas'; font-weight: bold; }
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox { background-color: #090F1D; border: 1px solid #334155; border-radius: 5px; color: #F8FAFC; padding: 3px 5px; min-height: 20px; }
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus { border-color: #22D3EE; }
QPushButton { background: #172033; color: #F8FAFC; border: 1px solid #334155; border-radius: 5px; padding: 4px 6px; font-weight: bold; min-height: 22px; }
QPushButton:hover { background: #223047; border-color: #22D3EE; }
QPushButton:disabled { background: #111827; color: #475569; border-color: #334155; }
QPushButton#btn_mode_room:checked { background-color: #0EA5E9; color: #FFFFFF; border-color: #7DD3FC; }
QPushButton#btn_mode_wall:checked { background-color: #64748B; color: #FFFFFF; border-color: #CBD5E1; }
QPushButton#btn_mode_draw:checked { background-color: #2563EB; color: #FFFFFF; border-color: #93C5FD; }
QPushButton#btn_mode_object:checked { background-color: #F59E0B; color: #111827; border-color: #FCD34D; }
QPushButton#btn_mode_edit_map:checked, QPushButton#btn_mode_edit:checked { background-color: #7C3AED; color: #FFFFFF; border-color: #C4B5FD; }
QPushButton#btn_save_map { background: #2563EB; color: #FFFFFF; border-color: #60A5FA; }
QPushButton#btn_clear_map, QPushButton#btn_exit_editor { background: #334155; color: #FFFFFF; border-color: #475569; }
QGroupBox { background: rgba(15, 23, 42, 0.35); color: #CBD5E1; font-weight: bold; border: 1px solid rgba(51, 65, 85, 0.88); border-radius: 6px; margin-top: 8px; padding-top: 14px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; color: #A5B4FC; }
QTabWidget::pane { border: none; background: transparent; }
QTabBar::tab { background: #111827; color: #94A3B8; border: 1px solid #334155; border-radius: 5px; padding: 5px 8px; font-weight: bold; min-width: 96px; margin-right: 4px; }
QTabBar::tab:selected { background: #1E293B; color: #22D3EE; border-color: #22D3EE; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background-color: transparent; width: 8px; margin: 0px; }
QScrollBar::handle:vertical { background-color: #475569; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; background: none; }</string>
