QTabBar::tab { background: #231E3D; color: #C4B5FD; border: 1px solid transparent; border-radius: 8px; padding: 12px 18px; margin: 4px 8px; font-weight: bold; }
QTabBar::tab:selected { background: #382F5F; color: #FFFFFF; border-left: 4px solid #A78BFA; }
