            <item row="4" column="0"><widget class="QLabel" name="lbl_err_max"><property name="text"><string>Error Max:</string></property><property name="styleSheet"><string notr="true">color: #94A3B8; font-weight: bold;</string></property></widget></item>
            <item row="4" column="1"><widget class="QLabel" name="val_err_max"><property name="text"><string>0.000 m</string></property><property name="styleSheet"><string notr="true">color: #F8FAFC; font-size: 14px;</string></property></widget></item>
