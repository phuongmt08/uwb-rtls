           <layout class="QVBoxLayout" name="opts_layout">
            <item><widget class="QCheckBox" name="chk_height"><property name="text"><string>Enable Height Calibration</string></property></widget></item>
            <item><widget class="QCheckBox" name="chk_auto_apply"><property name="text"><string>Auto-apply delay after calibration</string></property></widget></item>
            <item><widget class="QCheckBox" name="chk_save_flash"><property name="text"><string>Save calibration to flash</string></property></widget></item>
