<ui version="4.0">
 <class>ConfigTab</class>
 <widget class="QWidget" name="ConfigTab">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1300</width>
    <height>800</height>
   </rect>
  </property>
  <property name="styleSheet">
   <string>QWidget#ConfigTab {
    background-color: #0F172A;
    color: #F8FAFC;
    font-family: 'Segoe UI';
    font-size: 13px;
}
QGroupBox {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-top: 18px;
    padding: 20px 12px 12px 12px;
    font-weight: bold;
    font-size: 13px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    padding: 4px 10px;
    color: #22D3EE;
    background-color: rgba(34, 211, 238, 0.10);
    border-left: 3px solid #22D3EE;
    border-bottom: 1px solid rgba(34, 211, 238, 0.45);
    border-radius: 4px;
    font-family: 'Segoe UI';
    font-size: 14px;
    font-weight: bold;
}
QPushButton {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: bold;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #253346;
    border-color: #22D3EE;
}
QPushButton:disabled {
    background-color: #0A0F1E;
    color: #64748B;
    border-color: #334155;
}
QTableWidget {
    background-color: #0A0F1E;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    gridline-color: #334155;
    selection-background-color: rgba(34, 211, 238, 0.15);
    selection-color: #22D3EE;
    alternate-background-color: #1E293B;
}
QHeaderView::section {
    background-color: #1E293B;
    color: #22D3EE;
    border: 1px solid #334155;
    padding: 8px;
    font-weight: bold;
}
QSpinBox, QDoubleSpinBox {
    background-color: #0A0F1E;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
    padding: 6px 26px 6px 10px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #22D3EE;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #334155;
    border-top-right-radius: 6px;
    background-color: #0A0F1E;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: rgba(34, 211, 238, 0.15);
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    border-left: 1px solid #334155;
    border-bottom-right-radius: 6px;
    background-color: #0A0F1E;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: rgba(34, 211, 238, 0.15);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #F8FAFC;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #F8FAFC;
}
QComboBox {
    background-color: #0A0F1E;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 100px;
}
QComboBox:focus {
    border-color: #22D3EE;
}
QComboBox::drop-down {
    border: none;
    width: 30px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}
QComboBox::down-arrow {
    image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScxMCcgaGVpZ2h0PSc2JyB2aWV3Qm94PScwIDAgMTAgNic+PHBhdGggZD0nTTEuNSAxLjUgTDUgNC41IEw4LjUgMS41JyBzdHJva2U9JyM5NEEzQjgnIHN0cm9rZS13aWR0aD0nMS41JyBmaWxsPSdub25lJyBzdHJva2UtbGluZWNhcD0ncm91bmQnIHN0cm9rZS1saW5lam9pbj0ncm91bmQnLz48L3N2Zz4=");
    width: 10px;
    height: 6px;
}
QComboBox::down-arrow:hover {
    image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScxMCcgaGVpZ2h0PSc2JyB2aWV3Qm94PScwIDAgMTAgNic+PHBhdGggZD0nTTEuNSAxLjUgTDUgNC41IEw4LjUgMS41JyBzdHJva2U9JyMyMkQzRUUnIHN0cm9rZS13aWR0aD0nMS41JyBmaWxsPSdub25lJyBzdHJva2UtbGluZWNhcD0ncm91bmQnIHN0cm9rZS1saW5lam9pbj0ncm91bmQnLz48L3N2Zz4=");
}
QComboBox QAbstractItemView {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    selection-background-color: #0E7490;
    selection-color: #F8FAFC;
}
QCheckBox {
    color: #94A3B8;
    font-weight: bold;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #334155;
    border-radius: 4px;
    background-color: #0A0F1E;
}
QCheckBox::indicator:hover {
    border-color: #22D3EE;
}
QCheckBox::indicator:checked {
    background-color: #0E7490;
    border-color: #22D3EE;
    image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHdpZHRoPScxMCcgaGVpZ2h0PScxMCcgdmlld0JveD0nMCAwIDEwIDEwJz48cGF0aCBkPSdNMiA1IEw0IDcgTDggMycgc3Ryb2tlPScjMjJEM0VFJyBzdHJva2Utd2lkdGg9JzInIGZpbGw9J25vbmUnIHN0cm9rZS1saW5lY2FwPSdyb3VuZCcgc3Ryb2tlLWxpbmVqb2luPSdyb3VuZCcvPjwvc3ZnPg==");
}
</string>
